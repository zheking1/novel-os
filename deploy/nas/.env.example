COMPOSE_PROJECT_NAME=novel-os
TZ=Asia/Shanghai

# Host paths on the Ubuntu NAS. Keep everything under /opt/novel-os.
NAS_ROOT=/opt/novel-os

# PostgreSQL + pgvector
POSTGRES_BIND_ADDR=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=novel_os
POSTGRES_USER=novel_os
POSTGRES_PASSWORD=change_me_postgres_password

# Qdrant
QDRANT_BIND_ADDR=127.0.0.1
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=change_me_qdrant_api_key
QDRANT_MEMORY_COLLECTION=novel_memory_chunks
QDRANT_REFERENCE_COLLECTION=novel_reference_chunks
EMBEDDING_DIM=1536

# Existing Redis. Put the real password in .env only, never in git.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=change_me_existing_redis_password

# Optional Adminer UI
ADMINER_BIND_ADDR=127.0.0.1
ADMINER_PORT=8088

# MCP app. Keep localhost while auth is in dev mode.
NOVEL_MCP_BIND_ADDR=127.0.0.1
NOVEL_MCP_PORT=8787
NOVEL_OS_AUTH_MODE=dev

# Web console admin usernames (comma-separated). Never hardcode real account
# names in the repo — set the actual value here or in the container environment.
NOVEL_OS_ADMIN_USERS=admin

# Web console
NOVEL_WEB_BIND_ADDR=127.0.0.1
NOVEL_WEB_PORT=8790
