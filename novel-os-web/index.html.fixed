            <span>/</span>
            <span data-i18n="nav.canonCreate">New Document</span>
          </div>
          <div class="page-title" id="canonEditTitle" data-i18n="canon.edit.title">Edit Document</div>
        </div>

        <div class="card">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" data-i18n="field.docKey">Doc Key</label>
              <input class="form-input" id="canonKey" placeholder="world_overview">
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="field.docType">Type</label>
              <select class="form-select" id="canonType">
                <option value="world">world</option>
                <option value="character">character</option>
                <option value="magic">magic</option>
                <option value="timeline">timeline</option>
                <option value="setting">setting</option>
                <option value="other">other</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" data-i18n="field.title">Title</label>
            <input class="form-input" id="canonTitle" data-i18n-placeholder="placeholder.docTitle" placeholder="Document title">
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" data-i18n="field.status">Status</label>
              <select class="form-select" id="canonStatus">
                <option value="active">active</option>
                <option value="draft">draft</option>
                <option value="archived">archived</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="field.scope">Scope</label>
              <select class="form-select" id="canonScope">
                <option value="">global</option>
                <option value="volume">volume</option>
                <option value="chapter">chapter</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" data-i18n="field.content">Content</label>
            <textarea class="form-textarea" id="canonContent" data-i18n-placeholder="placeholder.docContent" placeholder="Document content..."></textarea>
          </div>
          <div class="btn-group">
            <button id="canonUpsert" data-i18n="action.save">Save</button>
            <button class="btn-secondary" onclick="goToPage('canon-list')" data-i18n="action.back">Back to List</button>
            <button class="btn-secondary" id="canonGet" data-i18n="action.get">Get</button>
            <button class="btn-danger" id="canonArchive" data-i18n="action.archive">Archive</button>
          </div>
        </div>
