      <!-- Entities: Create/Edit Page -->
      <div class="page hidden" id="page-entities-create">
        <div class="page-header">
          <div class="page-breadcrumb">
            <span data-i18n="nav.entities">Entities</span>
            <span>/</span>
            <span data-i18n="nav.entityCreate">New Entity</span>
          </div>
          <div class="page-title" id="entityEditTitle" data-i18n="entities.entityForm">Entity Details</div>
        </div>

        <div class="grid-2">
          <div class="card">
            <div class="card-title" data-i18n="field.basicInfo">Basic Info</div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" data-i18n="field.entityType">Entity Type</label>
                <select class="form-select" id="entityType">
                  <option value="character">character</option>
                  <option value="faction">faction</option>
                  <option value="location">location</option>
                  <option value="item">item</option>
                  <option value="other">other</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" data-i18n="field.name">Name</label>
                <input class="form-input" id="entityName" data-i18n-placeholder="placeholder.entityName" placeholder="Entity name">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" data-i18n="field.status">Status</label>
                <select class="form-select" id="entityStatus">
                  <option value="active">active</option>
                  <option value="inactive">inactive</option>
                  <option value="deceased">deceased</option>
                  <option value="archived">archived</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" data-i18n="field.importance">Importance</label>
                <select class="form-select" id="entityImportance">
                  <option value="low">low</option>
                  <option value="medium" selected>medium</option>
                  <option value="high">high</option>
                  <option value="critical">critical</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="field.aliases">Aliases (comma-separated)</label>
              <input class="form-input" id="entityAliases" data-i18n-placeholder="placeholder.csv" placeholder="alias1, alias2">
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="field.tags">Tags (comma-separated)</label>
              <input class="form-input" id="entityTags" data-i18n-placeholder="placeholder.csv" placeholder="tag1, tag2">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" data-i18n="field.firstSeenVolume">First Seen Volume</label>
                <input class="form-input" id="firstSeenVolume" type="number" min="1" placeholder="1">
              </div>
              <div class="form-group">
                <label class="form-label" data-i18n="field.firstSeenChapter">First Seen Chapter</label>
                <input class="form-input" id="firstSeenChapter" type="number" min="1" placeholder="1">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" data-i18n="field.lastSeenVolume">Last Seen Volume</label>
                <input class="form-input" id="lastSeenVolume" type="number" min="1" placeholder="1">
              </div>
              <div class="form-group">
                <label class="form-label" data-i18n="field.lastSeenChapter">Last Seen Chapter</label>
                <input class="form-input" id="lastSeenChapter" type="number" min="1" placeholder="1">
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-title" data-i18n="field.profile">Profile & Metadata</div>
            <div class="form-group">
              <label class="form-label" data-i18n="field.profile">Profile (JSON)</label>
              <textarea class="form-textarea" id="entityProfile" placeholder='{"age": 25, "gender": "male"}'></textarea>
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="field.metadata">Metadata (JSON)</label>
              <textarea class="form-textarea" id="entityMetadata" placeholder='{"custom_field": "value"}'></textarea>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-title" data-i18n="entities.snapshotsTitle">State Snapshots</div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" data-i18n="field.chapter">Chapter</label>
              <input class="form-input" id="snapshotChapter" type="number" min="1" placeholder="1">
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="field.durationType">Duration</label>
              <select class="form-select" id="snapshotDuration">
                <option value="persistent">persistent</option>
                <option value="temporary">temporary</option>
                <option value="scene">scene</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label class="form-label" data-i18n="field.state">State (JSON)</label>
            <textarea class="form-textarea" id="snapshotState" placeholder='{"hp": 100, "mana": 50}'></textarea>
          </div>
          <div class="form-group">
            <label class="form-label" data-i18n="field.changeReason">Change Reason</label>
            <input class="form-input" id="snapshotReason" data-i18n-placeholder="placeholder.reason" placeholder="Reason for state change">
          </div>
          <div class="btn-group">
            <button class="btn btn-sm" id="snapshotAddBtn" data-i18n="action.addSnapshot">Add Snapshot</button>
            <button class="btn btn-sm btn-secondary" id="snapshotListBtn" data-i18n="action.listSnapshots">List Snapshots</button>
          </div>
          <div class="result-box" style="margin-top: 12px;" id="snapshotListResult"></div>
        </div>

        <div class="btn-group">
          <button id="entitySaveBtn" data-i18n="action.save">Save</button>
          <button class="btn-secondary" onclick="goToPage('entities-list')" data-i18n="action.back">Back to List</button>
          <button class="btn-secondary" id="entityGetBtn" data-i18n="action.get">Get</button>
          <button class="btn-secondary" id="entityClearBtn" data-i18n="action.clear">Clear</button>
        </div>
      </div>

      <!-- Entities: Relationships Page -->
      <div class="page hidden" id="page-entities-relations">
        <div class="page-header">
          <div class="page-breadcrumb">
            <span data-i18n="nav.entities">Entities</span>
            <span>/</span>
            <span data-i18n="nav.relations">Relationships</span>
          </div>
          <div class="page-title" data-i18n="entities.relationshipsTitle">Relationship Management</div>
        </div>

        <div class="grid-2">
          <div class="card">
            <div class="card-title" data-i18n="action.addRelation">Add Relationship</div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" data-i18n="field.relationType">Relation Type</label>
                <select class="form-select" id="relationType">
                  <option value="friend">friend</option>
                  <option value="enemy">enemy</option>
                  <option value="family">family</option>
                  <option value="mentor">mentor</option>
                  <option value="student">student</option>
                  <option value="allied">allied</option>
                  <option value="romantic">romantic</option>
                  <option value="other">other</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" data-i18n="field.attitude">Attitude</label>
                <select class="form-select" id="relationAttitude">
                  <option value="positive">positive</option>
                  <option value="neutral" selected>neutral</option>
                  <option value="negative">negative</option>
                  <option value="ambivalent">ambivalent</option>
                </select>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" data-i18n="field.sourceName">Source Entity</label>
                <input class="form-input" id="relationSourceName" data-i18n-placeholder="placeholder.entityName" placeholder="Source entity name">
              </div>
              <div class="form-group">
                <label class="form-label" data-i18n="field.targetName">Target Entity</label>
                <input class="form-input" id="relationTargetName" data-i18n-placeholder="placeholder.entityName" placeholder="Target entity name">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" data-i18n="field.intensity">Intensity (0-1)</label>
                <input class="form-input" id="relationIntensity" type="number" min="0" max="1" step="0.1" value="0.5">
              </div>
              <div class="form-group">
                <label class="form-label" data-i18n="field.sourceChapter">Source Chapter</label>
                <input class="form-input" id="relationChapter" type="number" min="1" placeholder="1">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <div class="checkbox-group">
                  <input type="checkbox" id="knownBySource" checked>
                  <label for="knownBySource" data-i18n="field.knownBySource">Known by source</label>
                </div>
              </div>
              <div class="form-group">
                <div class="checkbox-group">
                  <input type="checkbox" id="knownByTarget" checked>
                  <label for="knownByTarget" data-i18n="field.knownByTarget">Known by target</label>
                </div>
              </div>
              <div class="form-group">
                <div class="checkbox-group">
                  <input type="checkbox" id="knownByReader" checked>
                  <label for="knownByReader" data-i18n="field.knownByReader">Known by reader</label>
                </div>
              </div>
            </div>
            <div class="btn-group">
              <button id="relationAddBtn" data-i18n="action.add">Add</button>
            </div>
          </div>

          <div class="card">
            <div class="card-title">
              <span data-i18n="entities.relationshipsTitle">Relationship List</span>
              <div class="card-title-right">
                <button class="btn btn-sm" id="relationListBtn" data-i18n="action.refresh">Refresh</button>
              </div>
            </div>
            <div class="result-box" id="relationListResult"></div>
          </div>
        </div>
      </div>

