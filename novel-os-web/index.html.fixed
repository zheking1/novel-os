        "field.tags": "标签（逗号分隔）",
        "field.firstSeenVolume": "首次出现卷",
        "field.firstSeenChapter": "首次出现章",
        "field.lastSeenVolume": "最后出现卷",
        "field.lastSeenChapter": "最后出现章",
        "field.profile": "属性（JSON）",
        "field.metadata": "元数据（JSON）",
        "field.chapter": "章节",
        "field.durationType": "持续类型",
        "field.state": "状态（JSON）",
        "field.changeReason": "变更原因",
        "field.relationType": "关系类型",
        "field.attitude": "态度",
        "field.sourceName": "源实体",
        "field.targetName": "目标实体",
        "field.intensity": "强度（0-1）",
        "field.sourceChapter": "来源章节",
        "field.knownBySource": "源方知晓",
        "field.knownByTarget": "目标方知晓",
        "field.knownByReader": "读者知晓",
        "entities.entityForm": "实体详情",
        "entities.listTitle": "实体列表",
        "entities.snapshotsTitle": "状态快照",
        "entities.relationshipsTitle": "关系管理",
        "foreshadowing.title": "伏笔管理",
        "plot.volumesTitle": "卷管理",
        "plot.threadsTitle": "剧情线",
        "model.title": "模型配置",
        "model.costTitle": "成本报告",
        "rules.proposals.title": "规则提案",
        "rules.compliance.title": "合规规则",
        "rules.result.title": "结果",
        "field.checkText": "检查文本",
        "action.listRules": "规则列表",
        "action.effectiveRules": "生效规则",
        "action.checkConflicts": "检查冲突",
        "action.approve": "批准",
        "action.reject": "拒绝",
        "action.listCompliance": "合规列表",
        "action.checkCompliance": "检查文本",
        "action.listVolumes": "卷列表",
        "action.listThreads": "剧情线列表",
        "action.costReport": "成本报告",
        "rules.conflicts": "发现冲突",
        "rules.noConflicts": "无冲突",
        "msg.noProject": "请先选择项目",
        "msg.saved": "保存成功",
        "msg.loaded": "加载成功",
        "action.loadProjects": "加载项目"
      }
    };

    const initialLanguage = localStorage.getItem("novel_os_language")
      || (navigator.language && navigator.language.toLowerCase().startsWith("zh") ? "zh" : "en");
    let currentLanguage = translations[initialLanguage] ? initialLanguage : "en";
    window.__hasMcpToken = false;
    let currentPage = "canon-list";
    let sidebarCollapsed = false;

    function t(key) {
      return translations[currentLanguage][key] || translations.en[key] || key;
    }

    function updateTokenState(hasToken) {
      const el = $("tokenState");
      if (el) el.textContent = hasToken ? t("status.tokenStored") : t("status.tokenMissing");
    }

    function applyLanguage(language) {
      currentLanguage = translations[language] ? language : "en";
      localStorage.setItem("novel_os_language", currentLanguage);
      document.documentElement.lang = currentLanguage === "zh" ? "zh-CN" : "en";
      document.querySelectorAll("[data-i18n]").forEach((node) => {
        node.textContent = t(node.dataset.i18n);
      });
      document.querySelectorAll("[data-i18n-placeholder]").forEach((node) => {
        node.placeholder = t(node.dataset.i18nPlaceholder);
      });
      updateTokenState(window.__hasMcpToken);
    }

    // ========== Navigation ==========
    function goToPage(pageName) {
      currentPage = pageName;
      
      // Hide all pages
      document.querySelectorAll(".page").forEach(p => p.classList.add("hidden"));
      
      // Show target page
      const targetPage = $("page-" + pageName);
      if (targetPage) targetPage.classList.remove("hidden");

      // Update sidebar active state
      document.querySelectorAll(".menu-item, .submenu-item").forEach(item => {
        item.classList.remove("active");
      });

      // Find and activate the menu group and submenu item
      const submenuItem = document.querySelector(`.submenu-item[data-page="${pageName}"]`);
      if (submenuItem) {
        submenuItem.classList.add("active");
        const menuGroup = submenuItem.closest(".menu-group");
        if (menuGroup) {
          menuGroup.classList.add("open");
          const menuItem = menuGroup.querySelector(".menu-item");
          if (menuItem) menuItem.classList.add("active");
        }
      }

      // Close dropdowns
      closeAllDropdowns();
    }

    // Sidebar toggle
    function toggleSidebar() {
      sidebarCollapsed = !sidebarCollapsed;
      $("sidebar").classList.toggle("collapsed", sidebarCollapsed);
      $("mainContent").classList.toggle("expanded", sidebarCollapsed);
    }

    // Dropdown handling
    function closeAllDropdowns() {
      document.querySelectorAll(".dropdown-menu").forEach(m => m.classList.remove("show"));
    }

    function setupDropdown(btnId, menuId) {
      const btn = $(btnId);
      const menu = $(menuId);
      if (!btn || !menu) return;
      
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = menu.classList.contains("show");
        closeAllDropdowns();
        if (!isOpen) menu.classList.add("show");
      });
    }

    document.addEventListener("click", closeAllDropdowns);

    // Menu group toggle
    function setupMenuGroups() {
      document.querySelectorAll(".menu-group").forEach(group => {
        const menuItem = group.querySelector(".menu-item");
        if (menuItem) {
          menuItem.addEventListener("click", () => {
            const hasSubmenu = group.querySelector(".submenu");
            if (hasSubmenu && !sidebarCollapsed) {
              group.classList.toggle("open");
            }
          });
        }
      });

      // Submenu item clicks
      document.querySelectorAll(".submenu-item").forEach(item => {
        item.addEventListener("click", () => {
          const page = item.dataset.page;
          if (page) goToPage(page);
        });
      });
    }

    // ========== Auth views ==========
    function show(view) {
      $("setupView").classList.toggle("hidden", view !== "setup");
      $("loginView").classList.toggle("hidden", view !== "login");
      $("appView").classList.toggle("hidden", view !== "app");
    }

    // ========== API ==========
    async function api(path, body) {
      const options = body ? {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body)
      } : {};
      const response = await fetch(path, options);
      return response.json();
    }

    function setStatus(text) {
      // Could add a toast notification here
      console.log("Status:", text);
    }

    async function refreshAuth() {
      const me = await api("/api/me");
      if ($("setupMcpUrl")) $("setupMcpUrl").value = me.default_mcp_url || "http://novel-os-mcp:8787/mcp";
      if (me.authenticated) {
        if ($("accountMcpUrl")) $("accountMcpUrl").value = me.mcp_url || me.default_mcp_url || "";
        window.__hasMcpToken = !!me.has_mcp_token;
        updateTokenState(window.__hasMcpToken);
        if (me.username) {
          const avatar = $("userBtn");
          if (avatar) avatar.textContent = me.username.charAt(0).toUpperCase();
        }
      }
      if (me.setup_required) show("setup");
      else if (me.authenticated) show("app");
      else show("login");
    }

    // ========== Tool calling ==========
    function baseProjectArgs() {
      return {
        workspace: $("workspaceSelect")?.value || $("workspace")?.value || "",
        project: $("projectSelect")?.value || $("project")?.value || ""
      };
    }

    function argsFor(form) {
      if (form === "user") return { username: $("newUser").value, display_name: $("displayName").value || null };
      if (form === "workspace") return { slug: $("newWorkspace").value, name: $("newWorkspace").value };
      if (form === "project") return { workspace: $("newWorkspace").value || $("workspace").value, slug: $("projectSlug").value, title: $("projectTitle").value };
      if (form === "projectList") return { workspace: $("newWorkspace").value || $("workspace").value };
      if (form === "proposalList") return { ...baseProjectArgs(), status: $("proposalStatus").value || null };
      if (form === "rulesList") return { ...baseProjectArgs() };
      if (form === "tasks") return { ...baseProjectArgs(), status: $("taskStatus").value || null };
      return {};
    }

    async function callTool(tool, arguments_) {
      setStatus(t("status.running") + " " + tool);
      const payload = { tool, arguments: arguments_ };
      if ($("mcpUrl")?.value) payload.mcp_url = $("mcpUrl").value;
      const response = await api("/api/tool", payload);
      
      const outputEl = $("output");
      if (outputEl) outputEl.textContent = JSON.stringify(response, null, 2);
      
      setStatus(response.ok ? t("status.done") : t("status.error"));
      return response;
    }

    // ========== State keys ==========
    const stateKeys = ["mcpUrl", "workspace", "project"];
    function loadState() {
      for (const key of stateKeys) {
        const saved = localStorage.getItem("novel_os_" + key);
        const el = $(key);
        if (saved && el) el.value = saved;
      }
    }
    function saveState() {
      for (const key of stateKeys) {
        const el = $(key);
        if (el) localStorage.setItem("novel_os_" + key, el.value);
      }
    }

    // ========== Project selector ==========
    let allProjects = [];

    async function loadProjects() {
      const workspace = $("workspaceSelect").value || $("workspace")?.value;
      if (!workspace) {
        setStatus(t("status.error") + ": workspace required");
        return;
      }
      setStatus(t("status.running"));
      try {
        const result = await api("/api/tool", {
          tool: "project.list",
          arguments: { workspace }
        });
        if (result.ok && Array.isArray(result.result)) {
          allProjects = result.result;
          const sel = $("projectSelect");
          sel.innerHTML = '<option value="">--</option>';
          allProjects.forEach(p => {
            const opt = document.createElement("option");
            opt.value = p.slug;
            opt.textContent = `${p.title || p.slug} (${p.slug})`;
            sel.appendChild(opt);
          });
          setStatus(t("msg.loaded"));
        } else {
          setStatus(t("status.error"));
        }
      } catch (e) {
        setStatus(t("status.error"));
      }
    }

    function getActiveProjectArgs() {
      const workspace = $("workspaceSelect")?.value || $("workspace")?.value;
      const project = $("projectSelect")?.value || $("project")?.value;
      if (!project) {
        setStatus(t("msg.noProject"));
        return null;
      }
      return { workspace, project };
    }

    // ========== Canon CRUD ==========
    function parseCsv(str) {
      if (!str || !str.trim()) return null;
      return str.split(",").map(s => s.trim()).filter(s => s.length > 0);
    }

    function parseJson(str, fallback) {
      if (!str || !str.trim()) return fallback;
      try {
        return JSON.parse(str);
      } catch (e) {
        return fallback;
      }
    }

    function renderCanonList(docs) {
      const container = $("canonListResult");
      if (!docs || docs.length === 0) {
        container.innerHTML = '<p style="color:var(--muted);text-align:center;padding:20px;">No documents found</p>';
        return;
      }
      container.innerHTML = docs.map(doc => `
        <div class="list-item" onclick="selectCanonDoc('${doc.key}')">
          <div class="list-item-header">
            <span>${doc.title || doc.key}</span>
            <span class="badge ${doc.status === 'draft' ? 'badge-draft' : doc.status === 'archived' ? 'badge-archived' : 'badge-active'}">${doc.status}</span>
          </div>
          <div class="list-item-meta">
            ${doc.key} | ${doc.doc_type} | v${doc.version}
          </div>
        </div>
      `).join("");
    }

    window.selectCanonDoc = (key) => {
      $("canonKey").value = key;
      loadCanonDoc(key);
    };

    async function loadCanonDoc(key) {
      const base = getActiveProjectArgs();
      if (!base) return;
      const args = { ...base, key };
      const result = await api("/api/tool", { tool: "canon.doc.get", arguments: args });
      if (result.ok && result.result) {
        const doc = result.result;
        $("canonKey").value = doc.key || "";
        $("canonTitle").value = doc.title || "";
        $("canonContent").value = doc.content || "";
        $("canonType").value = doc.doc_type || "other";
        $("canonStatus").value = doc.status || "active";
        const scope = doc.scope;
        if (scope && typeof scope === "object") {
          if (scope.volume_no) $("canonScope").value = "volume";
          else if (scope.chapter_no) $("canonScope").value = "chapter";
          else $("canonScope").value = "";
        }
        goToPage("canon-create");
        setStatus(t("msg.loaded"));
      }
    }

    // ========== Entities ==========
    let currentEntityId = null;

    function renderEntityList(entities) {
      const container = $("entityListResult");
      if (!entities || entities.length === 0) {
        container.innerHTML = '<p style="color:var(--muted);text-align:center;padding:20px;">No entities found</p>';
        return;
      }
      container.innerHTML = entities.map(entity => `
        <div class="list-item" onclick="selectEntity('${entity.id}', '${entity.entity_type}', '${entity.name}')">
          <div class="list-item-header">
            <span>${entity.name}</span>
            <span class="badge ${entity.lifecycle_status === 'active' ? 'badge-active' : entity.lifecycle_status === 'archived' ? 'badge-archived' : 'badge-warning'}">${entity.lifecycle_status || 'active'}</span>
          </div>
          <div class="list-item-meta">
            ${entity.entity_type} | ${entity.importance || 'medium'}
            ${entity.tags && entity.tags.length ? ' | ' + entity.tags.slice(0, 3).join(', ') : ''}
          </div>
        </div>
      `).join("");
    }

    window.selectEntity = (id, entityType, name) => {
      currentEntityId = id;
      $("entityType").value = entityType;
      $("entityName").value = name;
      loadEntityDetails(entityType, name);
    };

    async function loadEntityDetails(entityType, name) {
      const base = getActiveProjectArgs();
      if (!base) return;
      const args = { ...base, entity_type: entityType, name };
      setStatus(t("status.running"));
      const result = await api("/api/tool", { tool: "state.entity.get", arguments: args });
      if (result.ok && result.result) {
        const entity = result.result;
        currentEntityId = entity.id;
        $("entityType").value = entity.entity_type || "character";
        $("entityName").value = entity.name || "";
        $("entityStatus").value = entity.lifecycle_status || "active";
        $("entityImportance").value = entity.importance || "medium";
        $("entityAliases").value = entity.aliases ? entity.aliases.join(", ") : "";
        $("entityTags").value = entity.tags ? entity.tags.join(", ") : "";
        $("firstSeenVolume").value = entity.first_seen_volume_no || "";
        $("firstSeenChapter").value = entity.first_seen_chapter_no || "";
        $("lastSeenVolume").value = entity.last_seen_volume_no || "";
        $("lastSeenChapter").value = entity.last_seen_chapter_no || "";
        $("entityProfile").value = entity.profile ? JSON.stringify(entity.profile, null, 2) : "{}";
        $("entityMetadata").value = entity.metadata ? JSON.stringify(entity.metadata, null, 2) : "{}";
        goToPage("entities-create");
        setStatus(t("msg.loaded"));
      } else {
        setStatus(t("status.error"));
      }
    }

    function renderSnapshotList(snapshots) {
      const container = $("snapshotListResult");
      if (!snapshots || snapshots.length === 0) {
        container.innerHTML = '<p style="color:var(--muted);">No snapshots found</p>';
        return;
      }
      container.innerHTML = snapshots.map(snap => `
        <div class="result-item">
          <strong>Chapter ${snap.chapter_no || 'N/A'}</strong>
          ${snap.is_current ? '<span class="badge badge-success">current</span>' : ''}
          <span class="badge badge-warning">${snap.duration_type || 'persistent'}</span>
          ${snap.change_reason ? `<div style="font-size:12px;color:var(--muted);margin-top:4px;">${snap.change_reason}</div>` : ''}
          <pre class="output" style="font-size:11px;margin-top:4px;max-height:100px;overflow:auto;background:#f1f5f9;color:var(--text);">${JSON.stringify(snap.state || {}, null, 2)}</pre>
        </div>
      `).join("");
    }

    function renderRelationList(relations) {
      const container = $("relationListResult");
      if (!relations || relations.length === 0) {
        container.innerHTML = '<p style="color:var(--muted);">No relationships found</p>';
        return;
      }
      container.innerHTML = relations.map(rel => `
        <div class="result-item">
          <strong>${rel.source_name || rel.source_entity_id}</strong>
          <span style="color:var(--muted);"> → ${rel.relation_type} → </span>
          <strong>${rel.target_name || rel.target_entity_id}</strong>
          ${rel.attitude ? `<span class="badge ${rel.attitude === 'positive' ? 'badge-success' : rel.attitude === 'negative' ? 'badge-archived' : 'badge-warning'}">${rel.attitude}</span>` : ''}
          ${rel.intensity != null ? `<span style="font-size:11px;color:var(--muted);margin-left:6px;">intensity: ${rel.intensity}</span>` : ''}
          <div style="font-size:12px;color:var(--muted);margin-top:4px;">
            ${rel.status || 'active'}
            ${rel.source_chapter_no ? ' | ch. ' + rel.source_chapter_no : ''}
            ${!rel.known_by_reader ? ' | reader-hidden' : ''}
          </div>
        </div>
      `).join("");
    }

    // ========== Rules ==========
    function renderRulesResult(data, title, containerId) {
      const container = $(containerId);
      if (!container) return;
      if (!data || (Array.isArray(data) && data.length === 0)) {
        container.innerHTML = `<p style="color:var(--muted);">${title || 'No results'}</p>`;
        return;
      }
      if (Array.isArray(data)) {
        container.innerHTML = data.map(item => `
          <div class="result-item">
            <strong>${item.title || item.key || item.rule_key || item.id || 'Rule'}</strong>
            ${item.status ? `<span class="badge ${item.status === 'active' ? 'badge-active' : item.status === 'draft' ? 'badge-draft' : 'badge-archived'}">${item.status}</span>` : ''}
            ${item.severity ? `<span class="badge ${item.severity === 'critical' ? 'badge-archived' : 'badge-warning'}">${item.severity}</span>` : ''}
            <div style="font-size:12px;color:var(--muted);margin-top:4px;">
              ${item.content ? item.content.substring(0, 200) + '...' : ''}
              ${item.description ? item.description.substring(0, 200) : ''}
              ${item.message ? item.message : ''}
            </div>
          </div>
        `).join("");
      } else {
        container.innerHTML = `<pre class="output" style="font-size:12px;color:var(--text);">${JSON.stringify(data, null, 2)}</pre>`;
      }
    }

    // ========== Initialize ==========
    function init() {
      loadState();
      setupMenuGroups();
      setupDropdown("langBtn", "langMenu");
      setupDropdown("userBtn", "userMenu");

      // Sidebar toggle
      $("sidebarToggle").onclick = toggleSidebar;

      // Language dropdown
      document.querySelectorAll("#langMenu .dropdown-item").forEach(item => {
        item.addEventListener("click", () => {
          const lang = item.dataset.lang;
          applyLanguage(lang);
          refreshAuth();
        });
      });

      // User menu
      $("menuSettings").onclick = () => goToPage("system-connection");
      $("menuAccount").onclick = () => goToPage("system-account");
      $("logoutBtn").onclick = async () => {
        await api("/api/logout", {});
        await refreshAuth();
      };

      // Setup / Login
      $("setupButton").onclick = async () => {
        const result = await api("/api/setup", {
          username: $("setupUser").value,
          password: $("setupPassword").value,
          mcp_url: $("setupMcpUrl").value,
          token: $("setupToken").value
        });
        const outputEl = $("output");
        if (outputEl) outputEl.textContent = JSON.stringify(result, null, 2);
        await refreshAuth();
      };

      $("loginButton").onclick = async () => {
        const result = await api("/api/login", {
          username: $("loginUser").value,
          password: $("loginPassword").value
        });
        const outputEl = $("output");
        if (outputEl) outputEl.textContent = JSON.stringify(result, null, 2);
        await refreshAuth();
      };

      // Save connection
      $("save").onclick = () => {
        saveState();
        setStatus(t("status.saved"));
      };

      // Update account
      $("updateAccount").onclick = async () => {
        const result = await api("/api/account", {
          mcp_url: $("accountMcpUrl").value,
          mcp_token: $("accountToken").value
        });
        $("accountToken").value = "";
        const outputEl = $("output");
        if (outputEl) outputEl.textContent = JSON.stringify(result, null, 2);
        window.__hasMcpToken = !!result.has_mcp_token;
        updateTokenState(window.__hasMcpToken);
        setStatus(result.ok ? t("status.accountUpdated") : t("status.error"));
      };

      // Project selector
      $("loadProjects").onclick = loadProjects;
      $("projectSelect").onchange = () => {
        const project = $("projectSelect").value;
        if ($("project")) $("project").value = project;
      };

      // Tool buttons with data-tool
      document.querySelectorAll("[data-tool]").forEach((button) => {
        button.onclick = () => callTool(button.dataset.tool, argsFor(button.dataset.form));
      });

      // Manual tool call
      $("callTool").onclick = () => {
        let args = {};
        try { args = JSON.parse($("toolArgs").value || "{}"); }
        catch (err) {
          const outputEl = $("output");
          if (outputEl) outputEl.textContent = t("error.invalidJson") + ": " + err.message;
          return;
        }
        callTool($("toolName").value, args);
      };

      // ========== Canon buttons ==========
      $("canonUpsert").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const args = {
          ...base,
          key: $("canonKey").value,
          doc_type: $("canonType").value,
          title: $("canonTitle").value,
          content: $("canonContent").value,
          status: $("canonStatus").value,
          scope: $("canonScope").value || null
        };
        await callTool("canon.doc.upsert", args);
        setStatus(t("msg.saved"));
      };

      $("canonListBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const args = {
          ...base,
          status: $("canonListStatus").value || null,
          doc_type: $("canonListType").value || null,
          query: $("canonSearch").value || null
        };
        const result = await api("/api/tool", { tool: "canon.doc.list", arguments: args });
        if (result.ok && Array.isArray(result.result)) {
          renderCanonList(result.result);
          setStatus(t("msg.loaded"));
        }
      };

      $("canonGet").onclick = async () => {
        const key = $("canonKey").value;
        if (!key) { setStatus(t("status.error") + ": doc key required"); return; }
        loadCanonDoc(key);
      };

      $("canonArchive").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const key = $("canonKey").value;
        if (!key) { setStatus(t("status.error") + ": doc key required"); return; }
        const args = { ...base, key };
        await callTool("canon.doc.archive", args);
      };

      // ========== Entity buttons ==========
      $("entitySaveBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const name = $("entityName").value.trim();
        if (!name) { setStatus(t("status.error") + ": name required"); return; }
        const args = {
          ...base,
          entity_type: $("entityType").value,
          name: name,
          aliases: parseCsv($("entityAliases").value),
          profile: parseJson($("entityProfile").value, {}),
          lifecycle_status: $("entityStatus").value,
          importance: $("entityImportance").value,
          tags: parseCsv($("entityTags").value),
          first_seen_chapter_no: parseInt($("firstSeenChapter").value) || null,
          last_seen_chapter_no: parseInt($("lastSeenChapter").value) || null,
          first_seen_volume_no: parseInt($("firstSeenVolume").value) || null,
          last_seen_volume_no: parseInt($("lastSeenVolume").value) || null,
          source_type: "manual",
          metadata: parseJson($("entityMetadata").value, {})
        };
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "state.entity.upsert", arguments: args });
        if (result.ok) {
          if (result.result && result.result.id) currentEntityId = result.result.id;
          setStatus(t("msg.saved"));
          $("entityListBtn").click();
        } else {
          setStatus(t("status.error"));
        }
      };

      $("entityGetBtn").onclick = async () => {
        const name = $("entityName").value.trim();
        const entityType = $("entityType").value;
        if (!name) { setStatus(t("status.error") + ": name required"); return; }
        await loadEntityDetails(entityType, name);
      };

      $("entityClearBtn").onclick = () => {
        currentEntityId = null;
        $("entityType").value = "character";
        $("entityName").value = "";
        $("entityStatus").value = "active";
        $("entityImportance").value = "medium";
        $("entityAliases").value = "";
        $("entityTags").value = "";
        $("firstSeenVolume").value = "";
        $("firstSeenChapter").value = "";
        $("lastSeenVolume").value = "";
        $("lastSeenChapter").value = "";
        $("entityProfile").value = "{}";
        $("entityMetadata").value = "{}";
      };

      $("entityListBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const args = {
          ...base,
          entity_type: $("entityFilterType").value || null,
          lifecycle_status: $("entityFilterStatus").value || null,
          query: $("entitySearchQuery").value || null,
          include_archived: true,
          limit: 100,
          offset: 0
        };
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "state.entity.list", arguments: args });
        if (result.ok && Array.isArray(result.result)) {
          renderEntityList(result.result);
          setStatus(t("msg.loaded"));
        } else {
          setStatus(t("status.error"));
        }
      };

      $("entityBulkArchiveBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const idsStr = prompt("Enter entity IDs to archive (comma-separated):");
        if (!idsStr) return;
        const entityIds = idsStr.split(",").map(s => s.trim()).filter(s => s.length > 0);
        if (entityIds.length === 0) return;
        const args = { ...base, entity_ids: entityIds, patch: { lifecycle_status: "archived" } };
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "state.entity.bulk_patch", arguments: args });
        if (result.ok) {
          setStatus(t("msg.saved"));
          $("entityListBtn").click();
        } else {
          setStatus(t("status.error"));
        }
      };

      // Snapshots
      $("snapshotAddBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const name = $("entityName").value.trim();
        const entityType = $("entityType").value;
        if (!name) { setStatus(t("status.error") + ": select entity first"); return; }
        const state = parseJson($("snapshotState").value, {});
        const chapterNo = parseInt($("snapshotChapter").value) || null;
        const args = {
          ...base,
          state: state,
          entity_type: entityType,
          name: name,
          chapter_no: chapterNo,
          is_current: true,
          duration_type: $("snapshotDuration").value,
          change_reason: $("snapshotReason").value || null,
          source_type: "manual"
        };
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "state.snapshot.upsert", arguments: args });
        if (result.ok) {
          setStatus(t("msg.saved"));
          $("snapshotListBtn").click();
        } else {
          setStatus(t("status.error"));
        }
      };

      $("snapshotListBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const name = $("entityName").value.trim();
        const entityType = $("entityType").value;
        if (!name) { setStatus(t("status.error") + ": select entity first"); return; }
        const args = { ...base, entity_type: entityType, name, include_expired: true, limit: 50 };
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "state.snapshot.list", arguments: args });
        if (result.ok && Array.isArray(result.result)) {
          renderSnapshotList(result.result);
          setStatus(t("msg.loaded"));
        } else {
          setStatus(t("status.error"));
        }
      };

      // Relations
      $("relationAddBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const sourceName = $("relationSourceName").value.trim();
        const targetName = $("relationTargetName").value.trim();
        if (!sourceName || !targetName) { setStatus(t("status.error") + ": source and target names required"); return; }
        const args = {
          ...base,
          relation_type: $("relationType").value,
          source_name: sourceName,
          target_name: targetName,
          attitude: $("relationAttitude").value,
          intensity: parseFloat($("relationIntensity").value) || null,
          known_by_source: $("knownBySource").checked,
          known_by_target: $("knownByTarget").checked,
          known_by_reader: $("knownByReader").checked,
          status: "active",
          source_chapter_no: parseInt($("relationChapter").value) || null,
          source_type: "manual"
        };
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "state.relationship.upsert", arguments: args });
        if (result.ok) {
          setStatus(t("msg.saved"));
          $("relationListBtn").click();
        } else {
          setStatus(t("status.error"));
        }
      };

      $("relationListBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const name = $("entityName").value.trim();
        const entityType = $("entityType").value;
        const args = {
          ...base,
          entity_type: name ? entityType : null,
          name: name || null,
          status: null,
          include_reader_hidden: true,
          limit: 100
        };
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "state.relationship.list", arguments: args });
        if (result.ok && Array.isArray(result.result)) {
          renderRelationList(result.result);
          setStatus(t("msg.loaded"));
        } else {
          setStatus(t("status.error"));
        }
      };

      // ========== Rules buttons ==========
      $("rulesListBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const args = { ...base, status: $("ruleFilterStatus").value || null };
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "rules.list", arguments: args });
        if (result.ok) {
          renderRulesResult(result.result, "Rules", "rulesResult");
          setStatus(t("msg.loaded"));
        } else {
          setStatus(t("status.error"));
        }
      };

      $("rulesListEffectiveBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const args = { ...base, chapter_no: null, volume_no: null };
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "rules.list_effective", arguments: args });
        if (result.ok) {
          renderRulesResult(result.result, "Effective Rules", "rulesResult");
          setStatus(t("msg.loaded"));
        } else {
          setStatus(t("status.error"));
        }
      };

      $("rulesCheckConflictsBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "rules.check_conflict", arguments: { ...base } });
        if (result.ok) {
          if (result.result && result.result.conflicts && result.result.conflicts.length > 0) {
            renderRulesResult(result.result.conflicts, t("rules.conflicts"), "rulesResult");
          } else {
            $("rulesResult").innerHTML = `<p style="color:var(--muted);">${t("rules.noConflicts")}</p>`;
          }
          setStatus(t("msg.loaded"));
        } else {
          setStatus(t("status.error"));
        }
      };

      // Proposals
      $("listProposalsBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const args = { ...base, status: $("proposalStatus").value || null };
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "rules.list_proposals", arguments: args });
        if (result.ok) {
          renderRulesResult(result.result, "Proposals", "proposalsResult");
          setStatus(t("msg.loaded"));
        } else {
          setStatus(t("status.error"));
        }
      };

      $("approveProposalBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const proposalId = prompt("Enter proposal ID to approve:");
        if (!proposalId) return;
        await callTool("rules.approve_proposal", { ...base, proposal_id: proposalId });
      };

      $("rejectProposalBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const proposalId = prompt("Enter proposal ID to reject:");
        if (!proposalId) return;
        await callTool("rules.reject_proposal", { ...base, proposal_id: proposalId });
      };

      // Compliance
      $("complianceListBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "compliance.rule.list", arguments: { ...base } });
        if (result.ok) {
          renderRulesResult(result.result, "Compliance Rules", "complianceResult");
          setStatus(t("msg.loaded"));
        } else {
          setStatus(t("status.error"));
        }
      };

      $("complianceCheckBtn").onclick = async () => {
        const base = getActiveProjectArgs();
        if (!base) return;
        const text = $("complianceCheckText").value;
        if (!text) { setStatus(t("status.error") + ": text required"); return; }
        setStatus(t("status.running"));
        const result = await api("/api/tool", { tool: "compliance.check", arguments: { ...base, text } });
        if (result.ok) {
          renderRulesResult(result.result, "Compliance Check", "complianceResult");
          setStatus(t("msg.loaded"));
        } else {
          setStatus(t("status.error"));
        }
      };

      // Initial page
      goToPage("canon-list");

      // Apply language
      applyLanguage(currentLanguage);

      // Refresh auth
      refreshAuth().catch((err) => {
        setStatus(t("status.error"));
        show("login");
        console.error(err);
      });
    }

    // Run init when DOM is ready
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  </script>
</body>
</html>
