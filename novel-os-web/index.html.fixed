            <span data-i18n="nav.canonList">Document List</span>
          </div>
          <div class="page-title" data-i18n="canon.list.title">Canon Documents</div>
        </div>

        <div class="card">
          <div class="card-title">
            <span data-i18n="field.filter">Filter</span>
            <div class="card-title-right">
              <button class="btn btn-sm" id="canonListBtn" data-i18n="action.search">Search</button>
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" data-i18n="field.docType">Type</label>
              <select class="form-select" id="canonListType">
                <option value="">all</option>
                <option value="world">world</option>
                <option value="character">character</option>
                <option value="magic">magic</option>
                <option value="timeline">timeline</option>
                <option value="setting">setting</option>
                <option value="other">other</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="field.status">Status</label>
              <select class="form-select" id="canonListStatus">
                <option value="">all</option>
                <option value="active">active</option>
                <option value="draft">draft</option>
                <option value="archived">archived</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="field.search">Search</label>
              <input class="form-input" id="canonSearch" data-i18n-placeholder="placeholder.searchKeyword" placeholder="Search...">
            </div>
          </div>
        </div>

        <div class="card">
          <div class="card-title">
            <span data-i18n="canon.list.title">Document List</span>
            <div class="card-title-right">
              <button class="btn btn-sm" onclick="goToPage('canon-create')" data-i18n="action.newDoc">+ New</button>
            </div>
          </div>
          <div class="list-container" id="canonListResult"></div>
        </div>
      </div>

      <!-- Canon: Create/Edit Page -->
      <div class="page hidden" id="page-canon-create">
        <div class="page-header">
          <div class="page-breadcrumb">
