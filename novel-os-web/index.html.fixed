          <div class="btn-group">
            <button class="btn btn-sm" id="listProposalsBtn" data-i18n="action.listProposals">List proposals</button>
            <button class="btn btn-sm btn-secondary" id="approveProposalBtn" data-i18n="action.approve">Approve</button>
            <button class="btn btn-sm btn-secondary" id="rejectProposalBtn" data-i18n="action.reject">Reject</button>
          </div>
        </div>

        <div class="card">
          <div class="card-title" data-i18n="rules.result.title">Results</div>
          <div id="proposalsResult" class="result-box"></div>
        </div>
      </div>

      <!-- Rules: Compliance Page -->
      <div class="page hidden" id="page-rules-compliance">
        <div class="page-header">
          <div class="page-breadcrumb">
            <span data-i18n="nav.rules">Rules</span>
            <span>/</span>
            <span data-i18n="nav.compliance">Compliance</span>
          </div>
          <div class="page-title" data-i18n="rules.compliance.title">Compliance Rules</div>
        </div>

        <div class="card">
          <div class="card-title" data-i18n="rules.compliance.title">Compliance Check</div>
          <div class="form-group">
            <label class="form-label" data-i18n="field.checkText">Text to check</label>
            <textarea class="form-textarea" id="complianceCheckText" data-i18n-placeholder="placeholder.checkText" placeholder="Enter text to check for compliance issues..."></textarea>
          </div>
          <div class="btn-group">
            <button class="btn btn-sm" id="complianceListBtn" data-i18n="action.listCompliance">List compliance</button>
            <button class="btn btn-sm" id="complianceCheckBtn" data-i18n="action.checkCompliance">Check text</button>
          </div>
        </div>

        <div class="card">
          <div class="card-title" data-i18n="rules.result.title">Results</div>
          <div id="complianceResult" class="result-box"></div>
        </div>
      </div>

      <!-- Review: Tasks Page -->
      <div class="page hidden" id="page-review-tasks">
        <div class="page-header">
          <div class="page-breadcrumb">
            <span data-i18n="nav.review">Review</span>
            <span>/</span>
            <span data-i18n="nav.reviewTasks">Review Tasks</span>
          </div>
          <div class="page-title" data-i18n="tasks.title">Review Tasks</div>
        </div>

        <div class="card">
          <div class="card-title"><span data-i18n="field.filter">Filter</span></div>
          <div class="form-group">
            <label class="form-label" data-i18n="field.status">Status</label>
            <select class="form-select" id="taskStatus">
              <option value="open" data-i18n="option.open">open</option>
              <option value="" data-i18n="option.all">all</option>
              <option value="done" data-i18n="option.done">done</option>
            </select>
          </div>
          <div class="btn-group">
            <button class="btn btn-sm" data-tool="review.list_revision_tasks" data-form="tasks" data-i18n="action.listTasks">List tasks</button>
          </div>
        </div>

        <div class="card">
          <div class="card-title" data-i18n="tasks.title">Tasks</div>
          <div id="reviewResult" class="result-box"></div>
        </div>
      </div>

      <!-- Model: Profiles Page -->
      <div class="page hidden" id="page-model-profiles">
        <div class="page-header">
          <div class="page-breadcrumb">
            <span data-i18n="nav.model">Model & Cost</span>
            <span>/</span>
            <span data-i18n="nav.modelProfiles">Model Profiles</span>
          </div>
          <div class="page-title" data-i18n="model.title">Model Profiles</div>
        </div>

        <div class="card">
          <div class="card-title">
            <span data-i18n="model.title">Model Profiles</span>
            <div class="card-title-right">
              <button class="btn btn-sm" data-tool="model.profile.list" data-i18n="action.list">List</button>
            </div>
          </div>
          <div id="modelProfilesResult" class="result-box"></div>
        </div>
      </div>

      <!-- Model: Cost Report Page -->
      <div class="page hidden" id="page-model-cost">
        <div class="page-header">
          <div class="page-breadcrumb">
            <span data-i18n="nav.model">Model & Cost</span>
            <span>/</span>
            <span data-i18n="nav.costReport">Cost Report</span>
          </div>
          <div class="page-title" data-i18n="model.costTitle">Cost Report</div>
        </div>

        <div class="card">
          <div class="card-title">
            <span data-i18n="model.costTitle">Cost Report</span>
            <div class="card-title-right">
              <button class="btn btn-sm" data-tool="cost.report" data-i18n="action.costReport">Generate</button>
            </div>
          </div>
          <div id="costReportResult" class="result-box"></div>
        </div>
      </div>

      <!-- System: Connection Page -->
      <div class="page hidden" id="page-system-connection">
        <div class="page-header">
          <div class="page-breadcrumb">
            <span data-i18n="nav.system">System</span>
            <span>/</span>
            <span data-i18n="nav.connection">Connection</span>
          </div>
          <div class="page-title" data-i18n="connection.title">Connection Settings</div>
        </div>

        <div class="card">
          <div class="form-group">
            <label class="form-label" data-i18n="field.mcpUrlOverride">MCP URL override</label>
            <input class="form-input" id="mcpUrl" data-i18n-placeholder="placeholder.accountDefault" placeholder="Use account default">
          </div>
          <div class="form-group">
            <label class="form-label" data-i18n="field.workspace">Workspace</label>
            <input class="form-input" id="workspace" placeholder="default">
          </div>
          <div class="form-group">
            <label class="form-label" data-i18n="field.project">Project</label>
            <input class="form-input" id="project" placeholder="novel_slug">
          </div>
          <div class="btn-group">
            <button id="save" data-i18n="action.save">Save</button>
            <button class="btn-secondary" data-tool="auth.whoami" data-i18n="tool.whoami">Whoami</button>
            <button class="btn-secondary" data-tool="admin.health" data-i18n="tool.health">Health</button>
          </div>
        </div>
      </div>

      <!-- System: Account Page -->
      <div class="page hidden" id="page-system-account">
        <div class="page-header">
          <div class="page-breadcrumb">
            <span data-i18n="nav.system">System</span>
            <span>/</span>
            <span data-i18n="nav.account">Account</span>
          </div>
          <div class="page-title" data-i18n="account.title">Account Settings</div>
        </div>

        <div class="card">
          <div class="form-group">
            <label class="form-label" data-i18n="field.defaultMcpUrl">Default MCP URL</label>
            <input class="form-input" id="accountMcpUrl" placeholder="http://novel-os-mcp:8787/mcp">
          </div>
          <div class="form-group">
            <label class="form-label" data-i18n="field.newMcpToken">New MCP token</label>
            <input class="form-input" id="accountToken" type="password" autocomplete="off" data-i18n-placeholder="placeholder.leaveBlank" placeholder="Leave blank to keep current token">
          </div>
          <div class="form-label" id="tokenState" style="color: var(--muted); font-size: 12px;"></div>
          <div class="btn-group">
            <button id="updateAccount" data-i18n="action.updateMcpSettings">Update MCP settings</button>
          </div>
        </div>
      </div>

      <!-- System: Users Page -->
      <div class="page hidden" id="page-system-users">
        <div class="page-header">
          <div class="page-breadcrumb">
            <span data-i18n="nav.system">System</span>
            <span>/</span>
            <span data-i18n="nav.users">Users</span>
          </div>
          <div class="page-title" data-i18n="users.title">User Management</div>
        </div>

        <div class="card">
          <div class="card-title" data-i18n="action.create">Create User</div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" data-i18n="field.username">Username</label>
              <input class="form-input" id="newUser">
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="field.displayName">Display name</label>
              <input class="form-input" id="displayName">
            </div>
          </div>
          <div class="btn-group">
            <button data-tool="user.create" data-form="user" data-i18n="action.create">Create</button>
            <button class="btn-secondary" data-tool="user.list" data-i18n="action.list">List</button>
          </div>
        </div>

        <div class="card">
          <div class="card-title" data-i18n="workspaceProject.title">Workspace & Project</div>
          <div class="form-group">
            <label class="form-label" data-i18n="field.workspaceSlug">Workspace slug</label>
            <input class="form-input" id="newWorkspace">
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" data-i18n="field.projectSlug">Project slug</label>
              <input class="form-input" id="projectSlug">
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="field.projectTitle">Project title</label>
              <input class="form-input" id="projectTitle">
            </div>
          </div>
          <div class="btn-group">
            <button data-tool="workspace.create" data-form="workspace" data-i18n="action.createWorkspace">Create workspace</button>
            <button data-tool="project.create" data-form="project" data-i18n="action.createProject">Create project</button>
            <button class="btn-secondary" data-tool="project.list" data-form="projectList" data-i18n="action.listProjects">List projects</button>
          </div>
        </div>
      </div>

      <!-- System: Debug Page -->
      <div class="page hidden" id="page-system-debug">
        <div class="page-header">
          <div class="page-breadcrumb">
            <span data-i18n="nav.system">System</span>
            <span>/</span>
            <span data-i18n="nav.debug">Debug Tools</span>
          </div>
          <div class="page-title" data-i18n="tool.title">Tool Call</div>
        </div>

        <div class="card">
          <div class="card-title" data-i18n="tool.title">Manual Tool Call</div>
          <div class="form-group">
            <label class="form-label" data-i18n="field.tool">Tool</label>
            <input class="form-input" id="toolName" placeholder="rules.list">
          </div>
          <div class="form-group">
            <label class="form-label" data-i18n="field.argumentsJson">Arguments JSON</label>
            <textarea class="form-textarea" id="toolArgs">{}</textarea>
          </div>
          <div class="btn-group">
            <button id="callTool" data-i18n="action.run">Run</button>
          </div>
        </div>

        <div class="card">
          <div class="card-title" data-i18n="output.title">Output</div>
          <div id="outputPanel"><pre class="output" id="output">{}</pre></div>
        </div>
      </div>

    </main>
  </div>

