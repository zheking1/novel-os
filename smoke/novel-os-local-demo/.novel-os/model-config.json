{
  "providers": {
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY"
    },
    "openai_compatible": {
      "base_url": "https://example-openai-compatible-endpoint/v1",
      "api_key_env": "COMPATIBLE_API_KEY"
    }
  },
  "profiles": {
    "outline": [
      {
        "id": "outline-main",
        "provider": "openai",
        "model": "gpt-4.1",
        "temperature": 0.7,
        "max_tokens": 5000
      }
    ],
    "draft": [
      {
        "id": "draft-main",
        "provider": "openai",
        "model": "gpt-4.1",
        "temperature": 0.8,
        "max_tokens": 8000
      }
    ],
    "review": [
      {
        "id": "consistency-reviewer",
        "provider": "openai",
        "model": "gpt-4.1",
        "temperature": 0.2,
        "max_tokens": 2000
      },
      {
        "id": "pacing-reviewer",
        "provider": "openai",
        "model": "gpt-4.1",
        "temperature": 0.2,
        "max_tokens": 2000
      }
    ]
  }
}